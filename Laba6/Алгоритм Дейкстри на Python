import heapq

# Граф у вигляді словника суміжності: вершина -> список (сусід, вага)
graph = {
    1: [(2, 1), (3, 6), (4, 2)],
    2: [(1, 1), (5, 9), (6, 5)],
    3: [(1, 6), (4, 4), (6, 8), (8, 9)],
    4: [(1, 2), (3, 4), (5, 1)],
    5: [(2, 9), (4, 1), (7, 6)],
    6: [(2, 5), (3, 8), (7, 2)],
    7: [(5, 6), (6, 2), (8, 4)],
    8: [(3, 9), (7, 4)]
}

def dijkstra(graph, start):
    dist = {v: float('inf') for v in graph}   # відстані
    pred = {v: None for v in graph}           # попередники
    dist[start] = 0
    pq = [(0, start)]  # черга пріоритетів (dist, вершина)
    
    while pq:
        current_dist, u = heapq.heappop(pq)
        for v, weight in graph[u]:
            if dist[v] > current_dist + weight:
                dist[v] = current_dist + weight
                pred[v] = u
                heapq.heappush(pq, (dist[v], v))
    return dist, pred

# Виконуємо алгоритм від вершини 1
distances, predecessors = dijkstra(graph, 1)

# Вивід результатів
print("Вершина | Відстань | Шлях")
for v in sorted(graph):
    path = []
    current = v
    while current is not None:
        path.append(current)
        current = predecessors[current]
    path = path[::-1]  # розвертаємо шлях від джерела
    print(f"{v:>7} | {distances[v]:>8} | {'->'.join(map(str, path))}")
