INF = float('inf')

# Кількість вершин
V = 8

# Початкова матриця ваг ребер (0-індексація)
dist = [
    [0, 1, 6, 2, INF, INF, INF, INF],
    [1, 0, INF, INF, 9, 5, INF, INF],
    [6, INF, 0, 4, INF, 8, INF, 9],
    [2, INF, 4, 0, 1, INF, INF, INF],
    [INF, 9, INF, 1, 0, INF, 6, INF],
    [INF, INF, 8, INF, INF, 0, 2, INF],
    [INF, INF, INF, INF, 6, 2, 0, 4],
    [INF, INF, 9, INF, INF, INF, 4, 0]
]

# Алгоритм Флойда
for k in range(V):
    for i in range(V):
        for j in range(V):
            if dist[i][k] + dist[k][j] < dist[i][j]:
                dist[i][j] = dist[i][k] + dist[k][j]

# Вивід матриці найкоротших відстаней
print("Матриця найкоротших відстаней:")
for i in range(V):
    for j in range(V):
        if dist[i][j] == INF:
            print("INF".rjust(4), end=" ")
        else:
            print(str(dist[i][j]).rjust(4), end=" ")
    print()
