#include <iostream>
#include <cstring>
using namespace std;

#define INF 9999999
#define V 8

int G[V][V] = {
    //0   1    2    3    4    5    6    7
    {INF, 1,   6,   2,   INF, INF, INF, INF}, // 0 (1)
    {1,   INF, INF, INF, 9,   5,   INF, INF}, // 1 (2)
    {6,   INF, INF, 4,   INF, 8,   INF, 9  }, // 2 (3)
    {2,   INF, 4,   INF, 1,   INF, INF, INF}, // 3 (4)
    {INF, 9,   INF, 1,   INF, INF, 6,   INF}, // 4 (5)
    {INF, 5,   8,   INF, INF, INF, 2,   INF}, // 5 (6)
    {INF, INF, INF, INF, 6,   2,   INF, 4  }, // 6 (7)
    {INF, INF, 9,   INF, INF, INF, 4,   INF}  // 7 (8)
};

int main() {
    int no_edge = 0;
    int selected[V];
    memset(selected, false, sizeof(selected));

    selected[0] = true;

    int x = 0, y = 0;

    cout << "Edge : Weight\n";

    while (no_edge < V - 1) {
        int min = INF;

        for (int i = 0; i < V; i++) {
            if (selected[i]) {
                for (int j = 0; j < V; j++) {
                    if (!selected[j] && G[i][j] < min) {
                        min = G[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        cout << x << " - " << y << " : " << G[x][y] << endl;

        selected[y] = true;
        no_edge++;
    }

    return 0;
}
